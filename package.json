{
  "name": "tokens",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run build:tokens && nuxt build",
    "dev": "npm run build:tokens && nuxt dev",
    "generate": "npm run build:tokens && nuxt generate",
    "preview": "nuxt preview",
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs && node scripts/generate-tailwind-token-colors.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^4.4.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "style-dictionary": "^5.4.2",
    "tailwindcss": "^3.4.19"
  }
}
